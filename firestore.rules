rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isRootAdmin() {
      return isVerified() && request.auth.token.email == 'ywsfkrt300@gmail.com';
    }

    function isAdmin() {
      return isRootAdmin()
        || (isVerified() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data, uid) {
      return data.keys().hasAll(['uid', 'displayName', 'language', 'theme', 'streakDays', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'uid', 'displayName', 'email', 'language', 'theme', 'defaultReciterId',
          'streakDays', 'lastReadPage', 'lastReadSurah', 'lastReadAyah', 'lastReadDate',
          'khatmaTargetDays', 'khatmaCurrentPage', 'khatmaStartDate', 'weeklyPages',
          'createdAt', 'updatedAt'
        ])
        && data.uid is string && data.uid == uid && isValidId(data.uid)
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
        && (!data.keys().hasAny(['email']) || (data.email is string && data.email.size() <= 160))
        && data.language in ['ar', 'en']
        && data.theme in ['light', 'dark']
        && (!data.keys().hasAny(['defaultReciterId']) || (data.defaultReciterId is int && data.defaultReciterId >= 1 && data.defaultReciterId <= 10000))
        && data.streakDays is int && data.streakDays >= 0 && data.streakDays <= 50000
        && (!data.keys().hasAny(['lastReadPage']) || (data.lastReadPage is int && data.lastReadPage >= 1 && data.lastReadPage <= 604))
        && (!data.keys().hasAny(['lastReadSurah']) || (data.lastReadSurah is int && data.lastReadSurah >= 1 && data.lastReadSurah <= 114))
        && (!data.keys().hasAny(['lastReadAyah']) || (data.lastReadAyah is int && data.lastReadAyah >= 1 && data.lastReadAyah <= 286))
        && (!data.keys().hasAny(['lastReadDate']) || (data.lastReadDate is string && data.lastReadDate.size() <= 32))
        && (!data.keys().hasAny(['khatmaTargetDays']) || (data.khatmaTargetDays is int && data.khatmaTargetDays >= 1 && data.khatmaTargetDays <= 365))
        && (!data.keys().hasAny(['khatmaCurrentPage']) || (data.khatmaCurrentPage is int && data.khatmaCurrentPage >= 0 && data.khatmaCurrentPage <= 604))
        && (!data.keys().hasAny(['khatmaStartDate']) || (data.khatmaStartDate is string && data.khatmaStartDate.size() <= 32))
        && (!data.keys().hasAny(['weeklyPages']) || (data.weeklyPages is list && data.weeklyPages.size() == 7 && data.weeklyPages[0] is int))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidVerseBookmark(data, uid) {
      return data.keys().hasAll(['uid', 'verseKey', 'surahNumber', 'ayahNumber', 'pageNumber', 'highlightColor', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'verseKey', 'surahNumber', 'ayahNumber', 'pageNumber', 'highlightColor', 'note', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid == uid && isValidId(data.uid)
        && data.verseKey is string && data.verseKey.size() >= 3 && data.verseKey.size() <= 16 && data.verseKey.matches('^[0-9]{1,3}:[0-9]{1,3}$')
        && data.surahNumber is int && data.surahNumber >= 1 && data.surahNumber <= 114
        && data.ayahNumber is int && data.ayahNumber >= 1 && data.ayahNumber <= 286
        && data.pageNumber is int && data.pageNumber >= 1 && data.pageNumber <= 604
        && data.highlightColor in ['none', 'gold', 'emerald', 'sky', 'rose']
        && (!data.keys().hasAny(['note']) || (data.note is string && data.note.size() <= 1000))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMemorizationItem(data, uid) {
      return data.keys().hasAll(['uid', 'surahNumber', 'startAyah', 'endAyah', 'repetitions', 'easeFactor', 'intervalDays', 'nextReviewDate', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'surahNumber', 'startAyah', 'endAyah', 'repetitions', 'easeFactor', 'intervalDays', 'nextReviewDate', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid == uid && isValidId(data.uid)
        && data.surahNumber is int && data.surahNumber >= 1 && data.surahNumber <= 114
        && data.startAyah is int && data.startAyah >= 1 && data.startAyah <= 286
        && data.endAyah is int && data.endAyah >= data.startAyah && data.endAyah <= 286
        && data.repetitions is int && data.repetitions >= 0 && data.repetitions <= 10000
        && data.easeFactor is number && data.easeFactor >= 1.0 && data.easeFactor <= 5.0
        && data.intervalDays is int && data.intervalDays >= 0 && data.intervalDays <= 3650
        && data.nextReviewDate is string && data.nextReviewDate.size() >= 8 && data.nextReviewDate.size() <= 32
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidFavoriteRadio(data, uid) {
      return data.keys().hasAll(['uid', 'radioId', 'name', 'url', 'createdAt'])
        && data.keys().hasOnly(['uid', 'radioId', 'name', 'url', 'createdAt'])
        && data.uid is string && data.uid == uid && isValidId(data.uid)
        && data.radioId is int && data.radioId >= 1 && data.radioId <= 100000
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && data.url is string && data.url.size() >= 8 && data.url.size() <= 300
        && data.createdAt is timestamp;
    }

    function isValidAppAppearance(data) {
      return data.keys().hasAll(['backgroundType', 'backgroundUrl', 'backgroundOpacity', 'backgroundBlur', 'updatedBy', 'updatedAt'])
        && data.keys().hasOnly(['backgroundType', 'backgroundUrl', 'backgroundOpacity', 'backgroundBlur', 'updatedBy', 'updatedAt'])
        && data.backgroundType in ['default_mosque', 'preset', 'custom_url', 'custom_upload', 'none']
        && data.backgroundUrl is string && data.backgroundUrl.size() <= 400000
        && data.backgroundOpacity is number && data.backgroundOpacity >= 0.05 && data.backgroundOpacity <= 0.9
        && data.backgroundBlur is int && data.backgroundBlur >= 0 && data.backgroundBlur <= 24
        && data.updatedBy is string && data.updatedBy == request.auth.uid && isValidId(data.updatedBy)
        && data.updatedAt is timestamp;
    }

    function isValidVisitRecord(data, visitId) {
      return data.keys().hasAll(['visitId', 'country', 'countryCode', 'city', 'deviceType', 'language', 'path', 'createdAt'])
        && data.keys().hasOnly(['visitId', 'country', 'countryCode', 'city', 'deviceType', 'language', 'path', 'createdAt'])
        && data.visitId is string && data.visitId == visitId && isValidId(data.visitId)
        && data.country is string && data.country.size() >= 1 && data.country.size() <= 80
        && data.countryCode is string && data.countryCode.size() >= 2 && data.countryCode.size() <= 8
        && data.city is string && data.city.size() <= 80
        && data.deviceType in ['mobile', 'tablet', 'desktop']
        && data.language in ['ar', 'en']
        && data.path is string && data.path.size() >= 1 && data.path.size() <= 120
        && data.createdAt is timestamp;
    }

    function isValidAdminUser(data, uid) {
      return data.keys().hasAll(['uid', 'email', 'addedBy', 'createdAt'])
        && data.keys().hasOnly(['uid', 'email', 'addedBy', 'createdAt'])
        && data.uid is string && data.uid == uid && isValidId(data.uid)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
        && data.addedBy is string && data.addedBy == request.auth.uid && isValidId(data.addedBy)
        && data.createdAt is timestamp;
    }

    match /users/{uid} {
      allow get: if isValidId(uid) && (isOwner(uid) || isAdmin());
      allow list: if isRootAdmin();
      allow create: if isValidId(uid)
        && isVerified()
        && isOwner(uid)
        && isValidUserProfile(incoming(), uid)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(uid)
        && isVerified()
        && (isOwner(uid) || isAdmin())
        && isValidUserProfile(incoming(), uid)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName', 'email', 'language', 'theme', 'defaultReciterId',
          'streakDays', 'lastReadPage', 'lastReadSurah', 'lastReadAyah', 'lastReadDate',
          'khatmaTargetDays', 'khatmaCurrentPage', 'khatmaStartDate', 'weeklyPages',
          'updatedAt'
        ]);
      allow delete: if isValidId(uid) && (isOwner(uid) || isAdmin());

      match /bookmarks/{bookmarkId} {
        allow get: if isValidId(uid) && isValidId(bookmarkId) && isOwner(uid);
        allow list: if isValidId(uid) && isOwner(uid) && resource.data.uid == request.auth.uid;
        allow create: if isValidId(uid) && isValidId(bookmarkId)
          && isVerified()
          && isOwner(uid)
          && exists(/databases/$(database)/documents/users/$(uid))
          && isValidVerseBookmark(incoming(), uid)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isValidId(uid) && isValidId(bookmarkId)
          && isVerified()
          && isOwner(uid)
          && exists(/databases/$(database)/documents/users/$(uid))
          && isValidVerseBookmark(incoming(), uid)
          && incoming().uid == existing().uid
          && incoming().verseKey == existing().verseKey
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['highlightColor', 'note', 'updatedAt']);
        allow delete: if isValidId(uid) && isValidId(bookmarkId) && isOwner(uid);
      }

      match /memorization/{itemId} {
        allow get: if isValidId(uid) && isValidId(itemId) && isOwner(uid);
        allow list: if isValidId(uid) && isOwner(uid) && resource.data.uid == request.auth.uid;
        allow create: if isValidId(uid) && isValidId(itemId)
          && isVerified()
          && isOwner(uid)
          && exists(/databases/$(database)/documents/users/$(uid))
          && isValidMemorizationItem(incoming(), uid)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isValidId(uid) && isValidId(itemId)
          && isVerified()
          && isOwner(uid)
          && exists(/databases/$(database)/documents/users/$(uid))
          && isValidMemorizationItem(incoming(), uid)
          && incoming().uid == existing().uid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['repetitions', 'easeFactor', 'intervalDays', 'nextReviewDate', 'updatedAt']);
        allow delete: if isValidId(uid) && isValidId(itemId) && isOwner(uid);
      }

      match /favoriteRadios/{radioId} {
        allow get: if isValidId(uid) && isValidId(radioId) && isOwner(uid);
        allow list: if isValidId(uid) && isOwner(uid) && resource.data.uid == request.auth.uid;
        allow create: if isValidId(uid) && isValidId(radioId)
          && isVerified()
          && isOwner(uid)
          && exists(/databases/$(database)/documents/users/$(uid))
          && isValidFavoriteRadio(incoming(), uid)
          && incoming().createdAt == request.time;
        allow update: if false;
        allow delete: if isValidId(uid) && isValidId(radioId) && isOwner(uid);
      }
    }

    match /appConfig/{configId} {
      allow get: if isValidId(configId) && configId == 'appearance';
      allow list: if false;
      allow create, update: if isValidId(configId)
        && configId == 'appearance'
        && isAdmin()
        && isValidAppAppearance(incoming())
        && incoming().updatedAt == request.time;
      allow delete: if false;
    }

    match /visits/{visitId} {
      allow get: if isValidId(visitId) && isAdmin();
      allow list: if isRootAdmin();
      allow create: if isValidId(visitId)
        && isValidVisitRecord(incoming(), visitId)
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isValidId(visitId) && isAdmin();
    }

    match /admins/{uid} {
      allow get: if isValidId(uid) && (isOwner(uid) || isRootAdmin());
      allow list: if isRootAdmin();
      allow create: if isValidId(uid)
        && isRootAdmin()
        && isValidAdminUser(incoming(), uid)
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isValidId(uid) && isRootAdmin();
    }
  }
}
